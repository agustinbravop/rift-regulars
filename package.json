{
  "name": "rift-regulars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8765 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "start": "node --env-file-if-exists=.env --import ./scripts/local-server.ts build",
    "fetch": "node --env-file-if-exists=.env scripts/fetch.ts",
    "featured": "node --env-file-if-exists=.env scripts/featured.ts",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13"
}
